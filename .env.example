# Environment template — no real values belong in this file.
#
# Copy to `.env.production` and fill it in locally:
#     cp .env.example .env.production && chmod 600 .env.production
#
# The same file is used in two places:
#   - Vercel project settings (paste the same keys)
#   - `neon deploy --env .env.production` (bakes the function's copy)
#
# Every value is quoted on purpose. Unquoted values containing `&`, `#`, `$`,
# a backtick or a space break `set -a; . ./.env.production` — and the shell
# error can echo a credential fragment into your terminal. Neon pooled strings
# routinely contain `&` when more than one parameter is present.

# --- Neon PostgreSQL (required) --------------------------------------------
# Use the POOLED connection string from the Neon dashboard; it contains
# "-pooler" in the host. Keep `sslmode=require`.
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Filebase S3-compatible storage (required for uploads) ------------------
# Filebase → Buckets → Access Keys. The bucket MUST stay private: there is no
# bucket-policy API and object ACLs are ignored, so the bucket ACL is the only
# switch.
FILEBASE_ACCESS_KEY=""
FILEBASE_SECRET_KEY=""
FILEBASE_BUCKET=""
FILEBASE_ENDPOINT="https://s3.filebase.io"
# Filebase recommends "auto"; a wrong region is the documented top cause of
# SignatureDoesNotMatch. Use "us-east-1" only if a tool refuses "auto".
FILEBASE_REGION="auto"

# --- Application (optional) -------------------------------------------------
# Canonical public origin. Declared for configuration completeness; the app
# currently derives share links from the request origin, so changing this has
# no effect yet.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cleanup function only --------------------------------------------------
# NOT read by the web app. Declared in `neon.ts` and baked into the deployed
# function. Required for the V4 manual-invocation check; Neon trigger
# deliveries authenticate by header and do not use it.
#
# Generate with:   openssl rand -hex 32      # 64 characters
# Minimum length:  32
CLEANUP_SECRET=""

# --- Acceptance harness only ------------------------------------------------
# Returned by `neon functions get cleanup` (the `invocation_url`, with trailing
# slash). Leave empty until the function is deployed; it is only needed by
# `scripts/acceptance/run.sh` for the V4 check.
NEON_FUNCTION_URL=""

# --- Neon Auth --------------------------------------------------------------
# Print with:  neon neon-auth status --project-id <id> --branch production
# The browser never sees NEON_AUTH_COOKIE_SECRET; it signs session cookies on
# the server. Generate with: openssl rand -base64 32   (minimum 32 characters)
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
