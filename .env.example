# Copy to .env.local for local use. Never commit real values.

# --- Persistence -----------------------------------------------------------
# With these three set, records go to Firestore and uploads to Firebase
# Storage. Without them, everything is written to .data/ on the local disk,
# which does not survive on Vercel.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional; defaults to <projectId>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- Scheduled deletion ----------------------------------------------------
# Required by /api/cron/purge. Without it the route refuses to run (503).
# Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Local emulator --------------------------------------------------------
# These are set automatically by `firebase emulators:exec`; listed for reference.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
