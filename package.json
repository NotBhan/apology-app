    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@rive-app/react-canvas": "^4.38.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.10.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
