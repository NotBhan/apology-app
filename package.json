{
  "name": "apology-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "acceptance": "ACCEPTANCE=1 NODE_ENV=test vitest run src/acceptance/infrastructure.test.ts",
    "acceptance:full": "bash scripts/acceptance/run.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
