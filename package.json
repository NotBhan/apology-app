    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
