rules_version = '2';

// Uploaded photos and audio are never readable with the client SDK.
// Bytes are served by the application route, which checks that the owning
// letter is still live. The Admin SDK bypasses these rules, so this file is
// defence in depth: it stops a leaked client config from reading the bucket.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
